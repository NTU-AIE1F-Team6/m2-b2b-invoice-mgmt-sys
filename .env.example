# Base URL of the MockAPI project (no trailing slash, no resource name).
# Create a project at https://mockapi.io, add "invoices" and "referenceData"
# resources, and paste the project's base URL here.
# Leave unset to run against the static public/api/*.json fallback (offline demo data).
VITE_MOCKAPI_URL=https://<project-id>.mockapi.io
