{
  "name": "easyinvoice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EasyInvoice: a React + Vite simulation of the Singapore Peppol e-invoicing network (NTU AI Engineering, Module 2 group project).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "seed": "node --env-file=.env.local scripts/seed-mockapi.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}